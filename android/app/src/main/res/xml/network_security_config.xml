<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are often reached over plain http on the local network
     (http://192.168.x.x:8080), so cleartext is allowed. Use https for
     servers on the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
