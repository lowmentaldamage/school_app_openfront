# Copy to .env and edit.

# 1 = private: only players you create (with passwords) can play.
# 0 = public: anyone with the link can play, no login.
PRIVATE=1

# Admin login, used once on first start (when no accounts exist).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Port on your server (the container listens on 80 inside).
PORT=8080

# Your public hostname if you have one (e.g. game.example.com), else localhost.
DOMAIN=localhost

# Private group rules.
MAX_ACCOUNTS=100
MAX_DEVICES=2
# on = players can tap "Request access" (you approve); off = you add everyone.
REGISTRATION=on
MAX_FAILED_LOGINS=10

# Optional: approve players from Telegram.
# 1. In Telegram talk to @BotFather, /newbot, copy the token here.
# 2. Start the server, send /start to your bot: it answers with your chat id.
# 3. Put that number below and restart (docker compose up -d).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
